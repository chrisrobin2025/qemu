{
  "name": "Linux Mint",
  "service": "qemu",
  "containerEnv": {
    "BOOT": "https://downloads.blissroms.org/download/x86_64/BlissOS‑x86_64‑LATEST.iso"
  },
  "forwardPorts": [8006],
  "portsAttributes": {
    "8006": {
      "label": "Web",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }, 
  "dockerComposeFile": "codespaces.yml",
  "initializeCommand": "docker system prune --all --force"
}
